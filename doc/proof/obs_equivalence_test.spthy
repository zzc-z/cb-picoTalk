// Work-in-progress

theory OBS_EQ_TEST
begin

builtins: hashing

rule choose_password:
    [ ]
    --[ ChoosePassword() ]->
    [ !Password(diff($passwordA, $passwordB)) ]

rule publish:
    [ Fr(~nonce), !Password(pw) ]
    -->
    [ Out(h(<~nonce, pw>)) ]

end
